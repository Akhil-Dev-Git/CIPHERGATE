{
	"include": [
		"src/**/*.{ts,tsx,js,jsx}",
		"__create/**/*.{ts,tsx,js,jsx}",
		".react-router/types/**/*",
		"./src/global.d.ts"
	],
	"exclude": [
		"node_modules",
		"mobile",
		"CraftyHire"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "vite/client"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"baseUrl": ".",
		"esModuleInterop": true,
		"allowJs": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
